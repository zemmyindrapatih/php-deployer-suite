<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true">
    <testsuites>
        <testsuite name="sender">
            <directory>tests/sender</directory>
        </testsuite>
        <testsuite name="receiver">
            <directory>tests/receiver</directory>
        </testsuite>
    </testsuites>
    <coverage>
        <include>
            <directory suffix=".php">sender/src</directory>
            <directory suffix=".php">receiver/src</directory>
        </include>
    </coverage>
</phpunit>
